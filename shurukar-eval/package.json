{
  "name": "shurukar-eval",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "ingest": "npx tsx scripts/ingest.ts",
    "score": "npx tsx scripts/runPipeline.ts",
    "acceptance": "npx tsx scripts/acceptance.ts",
    "stub:laya": "npx tsx test/stubLaya.ts",
    "db:push": "node scripts/setDbProvider.mjs && prisma db push",
    "typecheck": "tsc --noEmit",
    "db:provider": "node scripts/setDbProvider.mjs",
    "prebuild": "node scripts/setDbProvider.mjs && prisma generate",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:logs": "docker compose logs -f app",
    "docker:seed": "docker compose exec app node dist/scripts/ingest.js test/candidates.json",
    "bundle:cli": "node scripts/bundleCli.mjs",
    "docker:score": "docker compose exec app node dist/scripts/runPipeline.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "csv-parse": "^7.0.3",
    "next": "15.0.0",
    "react": "19.0.0-rc-65a56d0e-20241020",
    "react-dom": "19.0.0-rc-65a56d0e-20241020"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.0.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
