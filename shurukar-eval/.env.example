# Local database. SQLite is fine for development; point at Postgres for a real
# cohort and change the provider in prisma/schema.prisma to match.
DATABASE_URL="file:./dev.db"

# --- Laya -------------------------------------------------------------------
# Server-side only. Never expose this to client code.
# With it unset the whole pipeline still runs and every candidate lands
# `unscored`, which is the correct and visible state — not an error.
LAYA_API_KEY=

# Defaults to https://autoextract.theboringpeople.in/api/laya
# LAYA_BASE_URL=

# Retry and timeout budget. ~0.5-1s per question per state on CPU, so a
# ten-question set is roughly 7-12s per candidate.
# LAYA_TIMEOUT_MS=90000
# LAYA_MAX_ATTEMPTS=4

# --- Assembly ---------------------------------------------------------------
# Below this confidence on a decisive question, a human decides instead.
# CONFIDENCE_FLOOR=0.5
# Content across a scenario's five decisive fields, below which there was not
# enough in the dossier to band on.
# THIN_DOSSIER_TOKENS=25

# --- Question sets ----------------------------------------------------------
# Defaults to test/question-sets.json. The version is a content hash of that
# file unless pinned here; scores from different versions are never compared.
# QUESTION_SETS_PATH=test/question-sets.json
# QUESTION_SET_VERSION=
