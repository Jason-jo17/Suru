# Copy to `.env` beside docker-compose.yml. Compose reads it automatically.
# Do not commit the real file — .gitignore already excludes it.

# Required. Postgres password for the bundled db service.
POSTGRES_PASSWORD=

# Host port to publish the app on.
PORT=3000

# --- Laya -------------------------------------------------------------------
# From your AutoExtract platform (bpl_...). Server-side only; it is never sent
# to client code. Leaving it empty is a SUPPORTED state, not an error: the
# pipeline runs end to end and every candidate lands `unscored`, which is
# visible in the UI and keeps them in the human queue.
LAYA_API_KEY=

# Defaults to https://autoextract.theboringpeople.in/api/laya
LAYA_BASE_URL=

# --- OpenRouter -------------------------------------------------------------
# Read by nothing yet. Stage 0 extraction (image / audio / video / PDF -> text)
# is not built; this is here so the container has it when it is.
# It must never be wired to scoring: an LLM standing in for Laya silently
# changes what a band means, with nothing in the UI showing it.
OPENROUTER_API_KEY=

# --- Optional tuning --------------------------------------------------------
# CONFIDENCE_FLOOR=0.5
# THIN_DOSSIER_TOKENS=25
# QUESTION_SET_VERSION=

# Set to 0 to skip the schema sync the entrypoint runs on every start.
RUN_DB_PUSH=1
